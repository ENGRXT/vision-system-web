# VISION-SYSTEM WEB - Variables de entorno
# Copiar a .env y configurar POSTGRES_PASSWORD antes de iniciar.
# Usa una contraseña aleatoria exclusiva (por ejemplo: openssl rand -hex 32).
# NUNCA commitear el .env real.

# Puerto expuesto por Nginx (80 para HTTP estandar)
# PostgreSQL
POSTGRES_USER=vision
POSTGRES_PASSWORD=
POSTGRES_DB=vision_system

# URL para ejecutar la API fuera de Docker (Compose define su propia URL interna).
# Sustituye <password> por el valor de POSTGRES_PASSWORD si usas esta URL local.
DATABASE_URL=postgresql+asyncpg://vision:<password>@localhost:5432/vision_system

# Servicio de IA compatible con API OpenAI.
# En Docker, host.docker.internal apunta al host; en ejecución local usa localhost.
AI_BASE_URL=http://host.docker.internal:8000/v1
AI_MODEL_NAME=qwen3-vl
AI_API_KEY=dummy
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# Almacenamiento de evidencia (dentro del contenedor)
STORAGE_BASE_PATH=/app/evidence

# Logging
LOG_LEVEL=INFO
