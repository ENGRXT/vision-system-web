# VISION-SYSTEM WEB - Variables de entorno
# Copiar a .env y ajustar valores. NUNCA commitear el .env real.

# Puerto expuesto por Nginx (80 para HTTP estandar)
VISION_PORT=80

# PostgreSQL
POSTGRES_USER=vision
POSTGRES_PASSWORD=CambiarEstaPassword123!
POSTGRES_DB=vision_system

# URL de la base de datos vista por la aplicacion
# (por defecto la resuelve Docker Compose hacia el contenedor postgres)
DATABASE_URL=postgresql+asyncpg://vision:CambiarEstaPassword123!@postgres:5432/vision_system

# AI Service (PC dedicada con vLLM)
AI_BASE_URL=http://10.145.123.27:8000/v1
AI_MODEL_NAME=qwen3-vl
AI_API_KEY=dummy
AI_TIMEOUT_SECONDS=180
AI_MAX_RETRIES=2

# Almacenamiento de evidencia (dentro del contenedor)
STORAGE_BASE_PATH=/app/evidence

# Logging
LOG_LEVEL=INFO
